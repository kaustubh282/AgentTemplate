{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "uid": "protec-ai-efficiency",
  "title": "ProTec AI - AI efficiency (\u00a758.12)",
  "description": "Token and cost telemetry from actual model calls. Every AI request has an execution record (\u00a75.7.8).",
  "tags": [
    "protec",
    "insurance-ai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Zero-model-call rate",
      "description": "Baseline 0.74. Alert fires below 0.65.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(protec_zero_model_call_requests_total[15m])) / sum(rate(protec_requests_total[15m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "id": 1
    },
    {
      "type": "stat",
      "title": "Model calls per request",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(protec_model_calls_total[15m])) / sum(rate(protec_requests_total[15m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Input tokens p50 / p95 / p99",
      "description": "Budgets: median <= 1500, p95 <= 2500 (\u00a759.2).",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(protec_model_input_tokens{quantile=\"0.5\"}) by (capability)",
          "legendFormat": "p50 {{capability}}"
        },
        {
          "refId": "B",
          "expr": "max(protec_model_input_tokens{quantile=\"0.95\"}) by (capability)",
          "legendFormat": "p95 {{capability}}"
        },
        {
          "refId": "C",
          "expr": "max(protec_model_input_tokens{quantile=\"0.99\"}) by (capability)",
          "legendFormat": "p99 {{capability}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Output tokens p50 by capability",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(protec_model_output_tokens{quantile=\"0.5\"}) by (capability)",
          "legendFormat": "{{capability}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Agent steps and handoffs (handoffs must be 0)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(protec_agent_steps_per_request{quantile=\"0.95\"}) by (capability)",
          "legendFormat": "steps p95 {{capability}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(protec_agent_handoffs_per_request_sum[15m]))",
          "legendFormat": "handoffs"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 5
    },
    {
      "type": "stat",
      "title": "Estimated cost per 1000 requests",
      "description": "Ceiling mirrors MAX_COST_PER_1000_MIXED_REQUESTS (\u00a735.1).",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * sum(rate(protec_model_estimated_cost_sum[1h])) / sum(rate(protec_requests_total[1h]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Cost by capability",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(protec_model_estimated_cost_sum[1h])) by (capability)",
          "legendFormat": "{{capability}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 7
    },
    {
      "type": "stat",
      "title": "Share of calls with estimated (not provider-reported) tokens",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(protec_model_tokens_estimated_total[1h])) / sum(rate(protec_model_calls_total[1h]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Model latency and first token p95",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(protec_model_latency_ms{quantile=\"0.95\"})",
          "legendFormat": "latency p95"
        },
        {
          "refId": "B",
          "expr": "max(protec_model_first_token_ms{quantile=\"0.95\"})",
          "legendFormat": "first token p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "id": 9
    },
    {
      "type": "stat",
      "title": "Model fallbacks",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(protec_fallback_total{kind=\"model\"}[1h]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "id": 10
    }
  ]
}
