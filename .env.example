# =============================================================================
# ProTec Insurance AI Template - environment reference
# =============================================================================
# Every variable the application reads is listed here. There are no undocumented
# environment variables (§53), and a test asserts this file stays complete:
#   tests/unit/test_configuration.py::test_env_example_documents_every_setting
#
# Copy to `.env` for local work. NEVER commit a real secret: values here are
# placeholders only, and production values come from the platform secret manager.
#
# Values marked REQUIRES_VERIFICATION must be confirmed by the owning team
# (Legal / Compliance / InfoSec / Finance) before production use.
# =============================================================================

# ------------------------------------------------------------------ application
APP_ENV=local                              # local | dev | test | preprod | prod
APP_NAME=protec-insurance-ai-template
APP_VERSION=0.1.0
LOG_LEVEL=INFO                             # DEBUG is refused in prod
DEBUG_ENDPOINTS_ENABLED=false              # must be false in prod
CORS_ALLOWED_ORIGINS=                      # comma separated; "*" is refused in prod

# -------------------------------------------------------------- authentication
# Production must use an asymmetric key (JWKS preferred). Symmetric secrets are
# refused outside local/dev/test by configuration validation.
JWT_ISSUER=https://auth.local.protec.example/
JWT_AUDIENCE=protec-insurance-ai
JWT_JWKS_URI=                              # e.g. https://idp.example/.well-known/jwks.json
JWT_ALLOWED_ALGORITHMS=RS256,ES256         # "none" is rejected; HS* rejected in prod
JWT_CLOCK_SKEW_SECONDS=30
JWT_PUBLIC_KEY_PEM=                        # alternative to JWKS for single-key setups
JWT_JWKS_CACHE_SECONDS=300                 # supports key rotation
JWT_DEV_HS256_SECRET=                      # local/dev/test ONLY

# ---------------------------------------------------------------------- model
MODEL_PROVIDER=deterministic               # deterministic | openai | bedrock
MODEL_ID=deterministic-test-model
MODEL_TIMEOUT_MS=12000
MODEL_MAX_TOKENS=800
MODEL_TEMPERATURE=0.0                      # conservative for regulated FAQ (§32)
MODEL_STREAMING_ENABLED=true
MODEL_FALLBACK_PROVIDER=none               # none | deterministic (non-prod only)
MODEL_API_KEY=                             # from the secret manager, never committed
MODEL_BASE_URL=
# REQUIRES_VERIFICATION: pricing assumptions for the FinOps report (§35).
MODEL_INPUT_COST_PER_1K=0.003
MODEL_OUTPUT_COST_PER_1K=0.015
MODEL_CURRENCY=USD

# ------------------------------------------------------------------------ RAG
RAG_KNOWLEDGE_DIR=knowledge
RAG_LIFECYCLE_STATE_PATH=var/knowledge/lifecycle.json   # persisted activate/supersede/revoke/quarantine (§34)
RAG_TOP_K=4
RAG_CANDIDATE_K=12
RAG_MIN_SCORE=0.12
RAG_RERANKER_ENABLED=false                 # off until evals justify it (§6.4)
RAG_TIMEOUT_MS=1500
RAG_ALLOW_DRAFT_SOURCES=false              # draft/superseded excluded by default
RAG_MAX_CHUNK_TOKENS=320

# ------------------------------------------------------------------ providers
# "mock" is refused in prod for every critical provider (§15.3).
CUSTOMER_PROVIDER=mock                     # mock | insuremo
POLICY_PROVIDER=mock
QUOTE_PROVIDER=mock
PRODUCT_PROVIDER=mock
CLAIMS_PROVIDER=mock
PAYMENT_PROVIDER=mock
DOCUMENT_PROVIDER=mock
REFERENCE_DATA_PROVIDER=mock
PROVIDER_TIMEOUT_MS=4000
PROVIDER_MAX_RETRIES=2
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RESET_SECONDS=15.0
# REQUIRES_VERIFICATION: no InsureMO specification has been supplied.
INSUREMO_BASE_URL=
INSUREMO_API_KEY=
INSUREMO_TENANT=

# ------------------------------------------------------------------- storage
# inmemory serves ONE process and is refused in prod. redis is the declared shared-store
# contract; the adapter is REQUIRES_IMPLEMENTATION and fails closed until it ships.
SESSION_STORE_PROVIDER=inmemory            # inmemory | redis
WORKFLOW_STORE_PROVIDER=inmemory           # inmemory | redis
RATE_LIMIT_STORE_PROVIDER=inmemory         # inmemory | redis
REDIS_URL=                                 # redis:// or rediss:// (fakeredis://<name> = test double, refused in prod)
# chained_file = HMAC hash-chained, tamper-evident sink (REQUIRED in prod); put the file
# on WORM/object-lock storage and keep AUDIT_CHAIN_SECRET with the verifier.
AUDIT_STORE_PROVIDER=inmemory              # inmemory | file | chained_file | chained_memory
AUDIT_FILE_PATH=var/audit/audit.log
AUDIT_CHAIN_SECRET=                        # required for chained_* providers
CACHE_PROVIDER=inmemory                    # inmemory | disabled
SESSION_TTL_SECONDS=3600
CONVERSATION_RETENTION_DAYS=30             # REQUIRES_VERIFICATION against retention policy
AUDIT_RETENTION_DAYS=2555                  # REQUIRES_VERIFICATION against retention policy

# -------------------------------------------------------------- observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=protec-insurance-ai
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACE_SAMPLE_RATE=1.0
AUDIT_FAIL_CLOSED=true                     # a required audit event is never dropped
HARNESS_RECORD_RETENTION=5000                 # in-process Harness records kept for FinOps/evals (§35)

# --------------------------------------------------------------- guardrails
GUARDRAIL_INPUT_MAX_CHARS=4000
GUARDRAIL_INJECTION_ENABLED=true
GUARDRAIL_INJECTION_BLOCK_SCORE=0.6
GUARDRAIL_OUTPUT_SCAN_ENABLED=true
GUARDRAIL_GROUNDING_MIN_SCORE=0.35         # evidence gate; tuned by eval evidence
GUARDRAIL_TOXICITY_ENABLED=true

# --------------------------------------------------------------- confirmation
# HMAC key for server-issued confirmation tokens on high-risk actions (§8). Shared by
# every instance; REQUIRED in prod. Empty = per-process random key (local only).
CONFIRMATION_TOKEN_SECRET=
WORKFLOW_RESERVATION_TTL_SECONDS=60           # side-effect reservation held before commit (§8)
PSEUDONYM_SECRET=                             # keyed pseudonyms for logs/audit/rate limits; required in preprod/prod (§22)

# -------------------------------------------------------------- rate limiting
RATE_LIMIT_ENABLED=true                    # must be true in prod
RATE_LIMIT_AI_PER_MINUTE=20                # expensive tier
RATE_LIMIT_DETERMINISTIC_PER_MINUTE=240    # cheap tier
RATE_LIMIT_PUBLIC_PER_MINUTE=10
RATE_LIMIT_BURST_MULTIPLIER=1.5

# ------------------------------------------------- context / token hard gate
MAX_CONTEXT_TOKENS=3500
MAX_HISTORY_TOKENS=600
MAX_HISTORY_TURNS=4
MAX_RETRIEVAL_TOKENS=1400
MAX_TOOL_RESULT_TOKENS=400
MAX_OUTPUT_TOKENS=500
MAX_AGENT_STEPS=3
MAX_MODEL_CALLS_PER_REQUEST=2
MAX_TOOL_CALLS_PER_REQUEST=4

# ---------------------------------------------------------------- latency SLO
SLO_DETERMINISTIC_P95_MS=300
SLO_CACHED_FAQ_P95_MS=1000
SLO_FAQ_P95_MS=3000
SLO_FIRST_TOKEN_P95_MS=1500
SLO_EXTRACTION_P95_MS=1500

# --------------------------------------------------------------------- FinOps
# REQUIRES_VERIFICATION: ceilings depend on the chosen provider pricing and traffic
# assumptions. CI fails when a configured ceiling is exceeded (§35.1).
MAX_COST_PER_1000_FAQ=25.0
MAX_COST_PER_1000_MIXED_REQUESTS=15.0
MAX_COST_PER_COMPLETED_TRANSACTION=0.10

# ---------------------------------------------------------------------- cache
FAQ_CACHE_ENABLED=true                     # public, version-keyed answers only
FAQ_CACHE_TTL_SECONDS=900
FAQ_CACHE_MAX_ENTRIES=512

# -------------------------------------------------------------- feature flags
FEATURE_PUBLIC_FAQ_ENABLED=true
FEATURE_TRAVEL_DOMAIN_ENABLED=true
FEATURE_AGENTIC_ESCALATION_ENABLED=true
FEATURE_STREAMING_ENABLED=false
FEATURE_WHATSAPP_CHANNEL_ENABLED=true          # text-channel adapter and /channels/whatsapp route (§45)

# =============================================================================
# Eval-only variables (not read by the application)
# =============================================================================
# LLM-as-judge metrics stay NOT_EVIDENCED unless a judge is configured (§26.12).
# RAGAS_JUDGE_API_KEY=
# RAGAS_JUDGE_MODEL=
# RAGAS_RUN_JUDGE_METRICS=0
# RAGAS_JUDGE_DISABLED=0
# DEEPEVAL_JUDGE_API_KEY=
# DEEPEVAL_JUDGE_DISABLED=0
# Threshold overrides, e.g. RAGAS_THRESHOLD_ROUGE_SCORE / DEEPEVAL_THRESHOLD_GROUNDEDNESS
