# Preprod: mirrors production. This is where readiness evidence is produced.
APP_ENV=preprod
LOG_LEVEL=INFO
DEBUG_ENDPOINTS_ENABLED=false

# Real model provider. MODEL_API_KEY comes from the secret manager.
MODEL_PROVIDER=openai
MODEL_ID=REQUIRES_VERIFICATION
MODEL_TEMPERATURE=0.0

# InsureMO sandbox, not mocks. INSUREMO_API_KEY from the secret manager.
CUSTOMER_PROVIDER=insuremo
POLICY_PROVIDER=insuremo
QUOTE_PROVIDER=insuremo
PRODUCT_PROVIDER=insuremo
CLAIMS_PROVIDER=insuremo
PAYMENT_PROVIDER=insuremo
DOCUMENT_PROVIDER=insuremo
REFERENCE_DATA_PROVIDER=insuremo
INSUREMO_BASE_URL=REQUIRES_VERIFICATION

# Production-like auth: asymmetric keys only.
JWT_ISSUER=REQUIRES_VERIFICATION
JWT_AUDIENCE=protec-insurance-ai
JWT_JWKS_URI=REQUIRES_VERIFICATION
JWT_ALLOWED_ALGORITHMS=RS256
JWT_DEV_HS256_SECRET=

# Preprod mirrors production (§15.2): the same startup guard applies. Shared stores and
# the tamper-evident audit sink are mandatory; the app refuses to start otherwise.
SESSION_STORE_PROVIDER=redis
WORKFLOW_STORE_PROVIDER=redis
RATE_LIMIT_STORE_PROVIDER=redis
REDIS_URL=REQUIRES_VERIFICATION                 # rediss:// recommended; redis:// tolerated in preprod only
AUDIT_STORE_PROVIDER=chained_file
AUDIT_FILE_PATH=/var/audit/audit.chain.log
AUDIT_FAIL_CLOSED=true

CORS_ALLOWED_ORIGINS=REQUIRES_VERIFICATION
RATE_LIMIT_ENABLED=true
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=REQUIRES_VERIFICATION
TRACE_SAMPLE_RATE=1.0

# Shared secrets from the secret manager (>= 32 chars each).
PSEUDONYM_SECRET=
CONFIRMATION_TOKEN_SECRET=
AUDIT_CHAIN_SECRET=
