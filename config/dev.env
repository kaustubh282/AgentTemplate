# Dev: shared integration. Mocks permitted so a broken upstream does not block work.
APP_ENV=dev
LOG_LEVEL=DEBUG

MODEL_PROVIDER=deterministic
POLICY_PROVIDER=mock
QUOTE_PROVIDER=mock
CUSTOMER_PROVIDER=mock
CLAIMS_PROVIDER=mock
PAYMENT_PROVIDER=mock

# Prefer JWKS here so the auth path matches production.
JWT_ISSUER=https://idp.dev.example/
JWT_JWKS_URI=https://idp.dev.example/.well-known/jwks.json
JWT_ALLOWED_ALGORITHMS=RS256

OTEL_ENABLED=true
TRACE_SAMPLE_RATE=1.0
RATE_LIMIT_ENABLED=true
