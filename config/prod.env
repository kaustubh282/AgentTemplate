# Production: hardened. The application REFUSES TO START if any of the following is
# unsafe - a mock critical provider, the deterministic model, a symmetric JWT
# algorithm, a dev secret, no JWKS or public key, debug endpoints, DEBUG logging,
# disabled rate limiting, or a wildcard CORS origin.
APP_ENV=prod
LOG_LEVEL=INFO
DEBUG_ENDPOINTS_ENABLED=false

MODEL_PROVIDER=openai
MODEL_ID=REQUIRES_VERIFICATION
MODEL_TEMPERATURE=0.0
MODEL_FALLBACK_PROVIDER=none

CUSTOMER_PROVIDER=insuremo
POLICY_PROVIDER=insuremo
QUOTE_PROVIDER=insuremo
PRODUCT_PROVIDER=insuremo
CLAIMS_PROVIDER=insuremo
PAYMENT_PROVIDER=insuremo
DOCUMENT_PROVIDER=insuremo
REFERENCE_DATA_PROVIDER=insuremo
INSUREMO_BASE_URL=REQUIRES_VERIFICATION

JWT_ISSUER=REQUIRES_VERIFICATION
JWT_AUDIENCE=protec-insurance-ai
JWT_JWKS_URI=REQUIRES_VERIFICATION
JWT_ALLOWED_ALGORITHMS=RS256
JWT_DEV_HS256_SECRET=

# Shared, replicated, tamper-evident. See blockers B1 and B2.
SESSION_STORE_PROVIDER=REQUIRES_VERIFICATION
WORKFLOW_STORE_PROVIDER=REQUIRES_VERIFICATION
AUDIT_STORE_PROVIDER=REQUIRES_VERIFICATION
AUDIT_FAIL_CLOSED=true

# Explicit origins only; a wildcard is refused.
CORS_ALLOWED_ORIGINS=REQUIRES_VERIFICATION

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_DETERMINISTIC_PER_MINUTE=240

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=REQUIRES_VERIFICATION
TRACE_SAMPLE_RATE=0.1

# REQUIRES_VERIFICATION: approved pricing and cost ceilings (OI-25).
MODEL_INPUT_COST_PER_1K=REQUIRES_VERIFICATION
MODEL_OUTPUT_COST_PER_1K=REQUIRES_VERIFICATION
MAX_COST_PER_1000_FAQ=REQUIRES_VERIFICATION

# Shared secrets from the secret manager (>= 32 chars each). Startup refuses weak or missing values.
PSEUDONYM_SECRET=
CONFIRMATION_TOKEN_SECRET=
AUDIT_CHAIN_SECRET=
