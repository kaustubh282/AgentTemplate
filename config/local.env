# Local: fully offline. No credentials, no network, no real data.
APP_ENV=local
LOG_LEVEL=DEBUG
DEBUG_ENDPOINTS_ENABLED=true

MODEL_PROVIDER=deterministic
CUSTOMER_PROVIDER=mock
POLICY_PROVIDER=mock
QUOTE_PROVIDER=mock
PRODUCT_PROVIDER=mock
CLAIMS_PROVIDER=mock
PAYMENT_PROVIDER=mock
DOCUMENT_PROVIDER=mock
REFERENCE_DATA_PROVIDER=mock

# Local-only symmetric secret. Configuration refuses this above dev/test.
JWT_DEV_HS256_SECRET=local-development-only-not-a-real-key
JWT_ALLOWED_ALGORITHMS=HS256

OTEL_ENABLED=false
TRACE_SAMPLE_RATE=1.0
RATE_LIMIT_ENABLED=true
