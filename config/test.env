# Test: what CI uses.
APP_ENV=test
LOG_LEVEL=INFO

MODEL_PROVIDER=deterministic
MODEL_TIMEOUT_MS=2000
POLICY_PROVIDER=mock
QUOTE_PROVIDER=mock
CUSTOMER_PROVIDER=mock
CLAIMS_PROVIDER=mock
PAYMENT_PROVIDER=mock

JWT_DEV_HS256_SECRET=unit-test-signing-secret-not-a-real-key
JWT_ALLOWED_ALGORITHMS=HS256

# Off so parallel tests do not throttle each other.
RATE_LIMIT_ENABLED=false
FAQ_CACHE_ENABLED=false

# Short dependency budgets keep the fault-injection suite fast; the timeout and
# retry behaviour under test is identical at production values.
PROVIDER_TIMEOUT_MS=300
PROVIDER_MAX_RETRIES=1

OTEL_ENABLED=false
